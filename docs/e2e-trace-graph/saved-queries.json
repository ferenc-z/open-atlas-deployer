[
  {
    "name": "e2e_records_by_correlation",
    "description": "Run records of one correlation id, in a time range (required), oldest first; at most 500.",
    "params": [
      {
        "name": "correlation_id",
        "type": "string",
        "required": true,
        "description": "The correlation id to look for.",
        "example": "aaaaaaaa-0000-4000-8000-00000000000a"
      },
      {
        "name": "from",
        "type": "string",
        "required": true,
        "description": "Start of the time range, ISO time (inclusive).",
        "example": "2020-01-01T00:00:00Z"
      },
      {
        "name": "to",
        "type": "string",
        "required": true,
        "description": "End of the time range, ISO time (exclusive).",
        "example": "2100-01-01T00:00:00Z"
      }
    ],
    "eql": "{:entity {:e2e.by_correlation/correlation_id ?correlation_id :e2e.by_correlation/from ?from :e2e.by_correlation/to ?to} :query [{:e2e.by_correlation/records [:e2e.record/row_key :e2e.record/correlation_id :e2e.record/schedule_id :e2e.record/schedule_name :e2e.record/schedule_seq :e2e.record/manager_name :e2e.record/worker_id :e2e.record/worker_name :e2e.record/process_stage :e2e.record/process_status :e2e.record/node_name :e2e.record/has_next_worker :e2e.record/next_worker_names :e2e.record/final_worker_name :e2e.record/file_name :e2e.record/source_path :e2e.record/email_from :e2e.record/email_subject :e2e.record/received_at]}]}"
  },
