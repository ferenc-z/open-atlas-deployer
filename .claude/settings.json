{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*commit*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/bin/claude-post-commit.sh\"",
            "asyncRewake": true,
            "timeout": 600
          }
        ]
      }
    ]
  }
}
