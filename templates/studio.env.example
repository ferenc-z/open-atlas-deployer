# Studio env template, kept by the Deployer (D27): Studio's repository has no .env.example.
# Source: open-atlas-docs install-and-configure guide 4.3 (config/studio.env), Studio 2.8.0.
# Fixed in the image, do not set: OPEN_ATLAS_STUDIO_HOME, OPEN_ATLAS_STUDIO_BUILDER_HOST, OPEN_ATLAS_STUDIO_DATA_HOST.
# Review at each new Studio version.

# Pool maintenance
OPEN_ATLAS_STUDIO_POOL_GC_ENABLED=true
#OPEN_ATLAS_STUDIO_POOL_GC_CHECK_MINUTES=
#OPEN_ATLAS_STUDIO_POOL_GC_INTERVAL_HOURS=
#OPEN_ATLAS_STUDIO_POOL_GC_MIN_INTERVAL_MINUTES=
#OPEN_ATLAS_STUDIO_POOL_GC_MIN_MIB=
#OPEN_ATLAS_STUDIO_POOL_GC_GROWTH_MIB=
#OPEN_ATLAS_STUDIO_POOL_GC_BACKUPS=

# Admin service token (atlas-pkg). Set both or neither; the user must already exist. Leave unset on first start.
#OPEN_ATLAS_STUDIO_ADMIN_TOKEN_SHA256=
#OPEN_ATLAS_STUDIO_ADMIN_TOKEN_USER=

# SSO
#OIDC_DISCOVERY_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=
#OIDC_PROVIDER_ID=
#OIDC_PROVIDER_NAME=
#OIDC_ISSUER=
#OIDC_ADDITIONAL_SCOPES=
#OIDC_CLAIM_IDENTIFYING_USER=
#OIDC_FALLBACK_CLAIMS_IDENTIFYING_USER=
#OIDC_ALLOWED_EMAIL_DOMAINS=

# HTTPS on 9631 directly (path inside the container)
#OPEN_ATLAS_STUDIO_BUILDER_TLS_KEYSTORE=
#OPEN_ATLAS_STUDIO_BUILDER_TLS_PASSWORD=

# Log retention
#OPEN_ATLAS_LOG_RETENTION_DAYS=
#OPEN_ATLAS_LOG_MAX_FILE_BYTES=
#OPEN_ATLAS_LOG_MAX_TOTAL_BYTES=

# Data source credentials referenced as ${VAR} by data sources go below (not needed with atlas-pkg).
