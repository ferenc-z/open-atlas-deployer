# Workbench env template, kept by the Deployer (D27): Workbench's repository has no deployment .env.example.
# Source: open-atlas-docs install-and-configure guide 4.4 (config/workbench.env), Workbench 1.23.1; checked against 1.25.1 (no new keys).
# Fixed in the image, do not set: OPEN_ATLAS_WORKBENCH_HOME, WORKBENCH_BIND, NODE_ENV.
# Set by the generated compose fragment: WORKBENCH_DATA_PLANE_URL.
# WORKBENCH_CREDENTIAL_ENCRYPTION_KEY is generated on first start into data/.env: back it up, never set it here.
# Review at each new Workbench version.

WORKBENCH_SECURE_COOKIES=true
WORKBENCH_PUBLIC_URL=
# Behind the TLS reverse proxy (same https domain as the Deployer)
WORKBENCH_HTTPS=off
#WORKBENCH_TLS_CERT=
#WORKBENCH_TLS_KEY=

WORKBENCH_PLUGINS_FILE=/data/workbench/plugins.json
WORKBENCH_ENTERPRISE=on
WORKBENCH_AUTH_MODE=local
#WORKBENCH_ADMIN_TOKEN_SHA256=
#WORKBENCH_APP_LINKS=

# SSO
#OIDC_DISCOVERY_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_REDIRECT_URI=

# First administrator, only while there are no users; remove afterwards
#WORKBENCH_BOOTSTRAP_EMAIL=
#WORKBENCH_BOOTSTRAP_PASSWORD=

# Outlook add-in
#WORKBENCH_OUTLOOK_ADDIN_ID=
#WORKBENCH_OUTLOOK_ADDIN_NAME=Workbench
#WORKBENCH_OUTLOOK_ADDINS=

# Attachments
#WORKBENCH_OCR_LANGUAGES=eng+chi_sim
#WORKBENCH_LIBREOFFICE_BIN=

# OMA timeouts (startup defaults; the real settings are in Administration)
#OMA_CONNECT_TIMEOUT_MS=5000
#OMA_READ_TIMEOUT_MS=600000
