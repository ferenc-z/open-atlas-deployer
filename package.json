{
  "name": "open-atlas-deployer",
  "version": "0.3.0-rc.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/server/index.ts",
    "dev": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen-compose": "node bin/gen-compose.ts",
    "import-manifests": "node bin/import-manifests.ts"
  },
  "dependencies": {
    "@hono/node-server": "1.19.17",
    "hono": "4.13.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.4.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
