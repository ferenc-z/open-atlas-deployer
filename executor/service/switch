#!/bin/sh
# Points the service executor at an installed release and restarts it (design §8.6): sudo ./switch <version>
# Without systemd (a host where it runs as a user, see install.sh): SWITCH_NO_RESTART=1 ./switch <version>, then restart it.
set -eu
base=${EXECUTOR_BASE:-/opt/open-atlas-deployer/service-executor}
version=${1:?usage: switch <version>   (installed: $(ls "$base/releases" | tr '\n' ' '))}
[ -d "$base/releases/$version" ] || { echo "not installed: $version" >&2; exit 1; }
ln -sfn "releases/$version" "$base/current.tmp" && mv -T "$base/current.tmp" "$base/current"
rm -f "${EXECUTOR_WORK:-/var/lib/open-atlas-service-executor}/upgrade-pending"
[ -n "${SWITCH_NO_RESTART:-}" ] || systemctl restart open-atlas-service-executor
echo "service executor now on $version"
