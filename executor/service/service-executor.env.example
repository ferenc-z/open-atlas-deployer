# /etc/open-atlas-deployer/service-executor.env (mode 600). Read by the service executor only (design S18).

# D35: the service executor calls the Deployer over HTTPS (the Deployer never calls the host). The token is the one an
# administrator issued for this host's *service executor* on the Deployer's Hosts page (dpe_…; a deploy executor's
# token is refused), one line, mode 600. EXECUTOR_CA_FILE: the internal CA when the Deployer's certificate is not
# publicly trusted.
EXECUTOR_DEPLOYER_URL=https://workbench.example.internal/deploy
EXECUTOR_TOKEN_FILE=/etc/open-atlas-deployer/service-executor.token
#EXECUTOR_CA_FILE=/etc/pki/ca-trust/source/anchors/company-ca.pem
#EXECUTOR_WAIT_SECONDS=25
EXECUTOR_WORK=/var/lib/open-atlas-service-executor

# svc-discover: besides the running NiFi (found from their processes), the directories looked at for installations,
# as globs separated by spaces or commas. Unset: /opt/nifi* /opt/*/nifi* /usr/local/nifi* /srv/nifi*; set and empty:
# none. An installation whose conf directory is elsewhere is followed through conf.dir in its conf/bootstrap.conf.
#EXECUTOR_SCAN_DIRS=/opt/nifi* /webapp/install*

# The read channel (§12): reads run side by side, at most this many at once, each within the timeout (seconds).
#EXECUTOR_READ_SLOTS=4
#EXECUTOR_READ_TIMEOUT=120

# The collector (§9.1, §15.3): samples the NiFi the Deployer registered on this host every this many seconds (30-300).
# Their REST API is called with this host's monitor certificate (a client certificate of the company CA with read
# policies only; files mode 600). Without it only the processes and the disks are sampled. The FlowFile trace
# (nifi-provenance, S28) reads provenance with it too. Its NiFi identity needs these read policies (the Takeover page
# lists them): /flow, /system, /controller (cluster status), /provenance ("query provenance"),
# /provenance-data/process-groups/<root group id> ("view provenance") and /data/process-groups/<root group id> ("view
# the data": the FlowFile attributes of provenance events; content is never read; on a cluster every node's own
# identity needs "view the data" too, as NiFi checks it for each proxy). The host name checked is
# nifi.web.https.host. EXECUTOR_NIFI_CA_RELAXED=1 accepts a CA whose Basic Constraints are not marked critical (Python
# 3.13+ refuses it by default), for CAs such as the one nifi-toolkit makes.
#EXECUTOR_COLLECT_SECONDS=60
# Back pressure (the root group's recursive status, large on a large flow) is read only every this many seconds
# (30-3600) and sent as a summary: the connections at their threshold and the fullest EXECUTOR_BACKPRESSURE_TOP queues (1-50).
#EXECUTOR_BACKPRESSURE_SECONDS=300
#EXECUTOR_BACKPRESSURE_TOP=5
#EXECUTOR_NIFI_CLIENT_CERT=/etc/open-atlas-deployer/nifi-monitor.crt
#EXECUTOR_NIFI_CLIENT_KEY=/etc/open-atlas-deployer/nifi-monitor.key
#EXECUTOR_NIFI_CA=/etc/open-atlas-deployer/nifi-ca.crt
#EXECUTOR_NIFI_CA_RELAXED=0

# Its own upgrades (design §8.6): the GitHub repository whose release executor-v<version> holds
# open-atlas-service-executor-<version>.tar.gz and SHA256SUMS, or an absolute directory holding executor-v<version>/
# with the same two files. Unset: upgrades are refused and stay manual (install.sh, switch).
#EXECUTOR_UPGRADE_FROM=ferenc-z/open-atlas-deployer
#EXECUTOR_GITHUB_TOKEN_FILE=/etc/open-atlas-deployer/github-readonly.token
#EXECUTOR_BASE=/opt/open-atlas-deployer/service-executor
