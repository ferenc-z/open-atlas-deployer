# /etc/open-atlas-deployer/service-executor.env (mode 600). Read by the service executor only (design S18).

# D35: the service executor calls the Deployer over HTTPS (the Deployer never calls the host). The token is the one an
# administrator issued for this host's *service executor* on the Deployer's Hosts page (dpe_…; a deploy executor's
# token is refused), one line, mode 600. EXECUTOR_CA_FILE: the internal CA when the Deployer's certificate is not
# publicly trusted.
EXECUTOR_DEPLOYER_URL=https://workbench.example.internal/deploy
EXECUTOR_TOKEN_FILE=/etc/open-atlas-deployer/service-executor.token
#EXECUTOR_CA_FILE=/etc/pki/ca-trust/source/anchors/company-ca.pem
#EXECUTOR_WAIT_SECONDS=25
EXECUTOR_WORK=/var/lib/open-atlas-service-executor

# The read channel (§12): reads run side by side, at most this many at once, each within the timeout (seconds).
#EXECUTOR_READ_SLOTS=4
#EXECUTOR_READ_TIMEOUT=120

# Its own upgrades (design §8.6): the GitHub repository whose release executor-v<version> holds
# open-atlas-service-executor-<version>.tar.gz and SHA256SUMS, or an absolute directory holding executor-v<version>/
# with the same two files. Unset: upgrades are refused and stay manual (install.sh, switch).
#EXECUTOR_UPGRADE_FROM=ferenc-z/open-atlas-deployer
#EXECUTOR_GITHUB_TOKEN_FILE=/etc/open-atlas-deployer/github-readonly.token
#EXECUTOR_BASE=/opt/open-atlas-deployer/service-executor
