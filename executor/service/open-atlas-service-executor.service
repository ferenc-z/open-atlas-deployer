[Unit]
Description=Open Atlas service executor (design S18)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root: it reads the managed services' files and later starts and stops them as each service's own user (runuser, S10).
# Requests name fixed actions only, on the paths the Deployer registered. No Docker.
User=root
EnvironmentFile=/etc/open-atlas-deployer/service-executor.env
ExecStart=/opt/open-atlas-deployer/service-executor/launch.sh
Restart=always
RestartSec=5
UMask=0022
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
