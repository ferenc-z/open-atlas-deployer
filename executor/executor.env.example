# /etc/open-atlas-deployer/executor.env (mode 600, root). Read by the executor only; the Deployer's container never sees it.

# The deploy root (one compose project, one fragment per app, design §7.3) and its project name.
EXECUTOR_ROOT=/webapp/data/open-atlas
EXECUTOR_PROJECT=open-atlas
# Shared with the Deployer's container: requests in, status and logs out. Defaults under <root>/deployer/.
#EXECUTOR_HANDOFF=/webapp/data/open-atlas/deployer/handoff
#EXECUTOR_STATE_FILE=/webapp/data/open-atlas/deployer/state/containers.jsonl
#EXECUTOR_BACKUPS=/webapp/data/open-atlas/deployer/backups
EXECUTOR_WORK=/var/lib/open-atlas-deployer-executor

# Registered registries (D13), space separated: the only places images are built into or pulled from, besides
# pinned public images. Push and pull credentials: `sudo docker login ghcr.io` (and the Harbor robot account).
EXECUTOR_REGISTRIES=ghcr.io/gaojie197710-tech

# Absolute host paths an environment may map data directories to (migration: existing data/studio etc.).
#EXECUTOR_BIND_ROOTS=/webapp/data/open-atlas/data

# GitHub read-only token (fine-grained; contents: read on open-atlas-release and the apps), one line, mode 600.
EXECUTOR_GITHUB_TOKEN_FILE=/etc/open-atlas-deployer/github-readonly.token
#EXECUTOR_TOOLS_REPO=gaojie197710-tech/open-atlas-release

#EXECUTOR_HEALTH_SECONDS=300
#EXECUTOR_KEEP_BACKUPS=3

# Databases outside the deploy manifest, per app (as the in-app upgrader's UPGRADE_DB_DUMP / UPGRADE_DB_RESTORE):
# the dump is taken before every deploy of that app; the restore runs only when the previous version does not
# start on what the new one left. Dossier's records are in PostgreSQL:
#EXECUTOR_DB_DUMP_DOSSIER=docker exec atlas-postgres-dossier-db-1 pg_dump -U dossier -d dossier -Fc --lock-wait-timeout=60000
#EXECUTOR_DB_RESTORE_DOSSIER=docker exec -i atlas-postgres-dossier-db-1 bash -c 'set -e; f=$(mktemp -d); trap "rm -rf $f" EXIT; cat > $f/d; pg_restore -f $f/s $f/d; psql -X -q -v ON_ERROR_STOP=1 --single-transaction -U dossier -d dossier -c "DROP SCHEMA public CASCADE; CREATE SCHEMA public" -f $f/s'
