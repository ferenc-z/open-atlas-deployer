# deployer.env beside compose.yaml (mode 600). The full list with defaults is the settings table in the README.
# File paths are inside the container: ./secrets is mounted at /secrets.

# Workbench: where the Deployer asks who is signed in (W1), and where the page sends people to sign in.
DEPLOYER_WORKBENCH_URL=http://workbench:8090
DEPLOYER_WORKBENCH_PUBLIC_URL=https://uat.example.internal:8443/
DEPLOYER_SECURE_COOKIES=true

# Environment variables management: openssl rand -base64 32. Back it up apart from data/: without it the secrets in
# the state database cannot be read. The compare key is the same value in UAT and PROD.
DEPLOYER_CREDENTIAL_ENCRYPTION_KEY=
DEPLOYER_COMPARE_KEY=

# GitHub read-only token (lists release tags, reads release assets and .env.example files).
DEPLOYER_GITHUB_TOKEN_FILE=/secrets/github-readonly.token

# The internal CA, when nginx's certificate is not publicly trusted: the check after a deploy goes through it.
#NODE_EXTRA_CA_CERTS=/secrets/company-ca.pem

# Emergency account while Workbench is down: node bin/hash-password.ts (reads the password on stdin).
#DEPLOYER_EMERGENCY_PASSWORD_HASH=

# Phase 5 drivers, phase 6–8 AI, PROD ↔ UAT: see the README's settings table.
#DEPLOYER_WORKBENCH_API_KEY_FILE=/secrets/workbench-api.key
#DEPLOYER_STUDIO_BUILDER_URL=http://studio:9631/mcp
#DEPLOYER_STUDIO_TOKEN_FILE=/secrets/studio-workspace.token
#DEPLOYER_OMA_BUILDER_URL=
#DEPLOYER_OMA_BUILDER_KEY_FILE=/secrets/oma-builder.key
#DEPLOYER_UAT_URL=
#DEPLOYER_UAT_KEY_FILE=/secrets/uat-peer.key
#DEPLOYER_PEER_KEY_SHA256=
